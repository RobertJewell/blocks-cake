{
  "name": "blocks-cakes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "deploy": "pnpm run build && wrangler deploy",
    "serve": "vite preview",
    "cf-typegen": "wrangler types --env-interface Env",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply database --local",
    "db:migrate:prod": "wrangler d1 migrations apply database --remote",
    "db:push:local": "pnpm db:generate && pnpm db:migrate:local",
    "db:push:prod": "pnpm db:generate && pnpm db:migrate:prod",
    "db:seed:local": "wrangler d1 execute database --local --file=src/scripts/seed-pages.sql",
    "db:seed:prod": "wrangler d1 execute database --remote --file=src/scripts/seed-pages.sql"
  },
  "better-auth": {
    "config": "./src/lib/auth.config.ts"
  },
