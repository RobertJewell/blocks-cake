{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blocks-cakes",
  "compatibility_date": "2025-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "vars": {
    "CLOUDFLARE_BROWSER_RENDERING_TOKEN": "PHKl8iWSbSWkRQpbXe3UYcsx0dN1lQ4wfMbP5RTg",
    "SITE_URL": "https://blocks-cakes.rjewellaudio.workers.dev",
    "BETTER_AUTH_URL": "https://blocks-cakes.rjewellaudio.workers.dev",
    "GOOGLE_CLIENT_ID": "526399404524-53k72oqm52ffvoejk5frg9m0ukbeeak6.apps.googleusercontent.com",
    "CLOUDFLARE_ACCOUNT_ID": "bcfacdd0f09674f8cae0297886b0ea76",
    "CLOUDFLARE_D1_DATABASE_ID": "29d1f84b-e2bc-43b1-bde2-1ee5b0358ab8",
    "CLOUDFLARE_R2_BASE_URL": "https://pub-39814712f705425ebdcd406e6d0a9361.r2.dev",
  },
  "d1_databases": [
    {
      "binding": "database",
      "database_name": "blocks-cake-db",
      "database_id": "29d1f84b-e2bc-43b1-bde2-1ee5b0358ab8",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "blocks_cakes_assets",
      "bucket_name": "blocks-cakes-assets",
      "remote": true,
    },
  ],
  "queues": {
    "producers": [
      {
        "queue": "blocks-optimise-image",
        "binding": "blocks_optimise_image",
      },
      {
        "queue": "blocks-capture-screenshot",
        "binding": "blocks_capture_screenshot",
      },
    ],
    "consumers": [
      {
        "queue": "blocks-optimise-image",
      },
      {
        "queue": "blocks-capture-screenshot",
      },
    ],
  },

  "ai": {
    "binding": "AI",
    "remote": true,
  },

  "images": {
    "binding": "IMAGES",
  },

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
}
